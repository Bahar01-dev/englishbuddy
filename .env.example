NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

ANTHROPIC_API_KEY=your-anthropic-api-key

ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=optional-voice-id

# Email-напоминания (FR-32, Resend). Без ключа отправка просто пропускается.
RESEND_API_KEY=your-resend-api-key
REMINDER_FROM_EMAIL=EnglishBuddy <reminders@your-domain.com>

# Защита cron-роута напоминаний (Vercel Cron шлёт этот секрет в Authorization)
CRON_SECRET=your-cron-secret

# Базовый URL приложения для ссылок в письмах
NEXT_PUBLIC_APP_URL=https://your-domain.com
